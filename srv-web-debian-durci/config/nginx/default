# /etc/nginx/sites-available/default

# HTTP : redirection vers HTTPS
# (port 8443 à cause de la redirection de ports VirtualBox 8443 -> 443)
server {
    listen 80;
    server_name _;
    return 301 https://$host:8443$request_uri;
}

# HTTPS
server {
    listen 443 ssl;
    server_name _;
    ssl_certificate /etc/ssl/certs/srv-web.crt;
    ssl_certificate_key /etc/ssl/private/srv-web.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    root /var/www/html;
    index index.html;
}
